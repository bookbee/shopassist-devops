# Platform-level knobs only — for shopassist-database's and shopassist-model's
# own settings (Postgres credentials, which models get pulled, etc.), edit
# *their* .env files, not this one. Compose reads each included project's
# .env relative to that project's own directory automatically.
#
# Copy to .env: cp .env.example .env (defaults below work as-is).

# Host ports the two web-facing containers are published on.
API_PORT=8000
WEB_PORT=8501

# Must match the `router`/`generative`/etc. value in
# shopassist-model/config/generative.yaml — that file decides what actually
# gets pulled into Ollama, this just tells shopassist which tag to ask
# for. Change both together if you change the model.
SHOPASSIST_MODEL=llama3.2:3b

# Only needed if you've changed shopassist-database's own POSTGRES_USER /
# POSTGRES_PASSWORD / POSTGRES_DB away from its .env.example defaults —
# these feed api's DATABASE_URL so the two projects keep agreeing on
# credentials. Leave unset to just use those defaults.
# SHOPASSIST_DATABASE_USER=shopassist
# SHOPASSIST_DATABASE_PASSWORD=shopassist123
# SHOPASSIST_DATABASE_NAME=shopassist

# Passed through to shopassist-client (the storefront client).
APP_TITLE=IISc Alumni Store
LOG_LEVEL=INFO

# Only used by the optional observability overlay
# (observability/docker-compose.observability.yml) — see the README's
# "Optional: observability" section. Change the admin password before this
# ever runs anywhere beyond a laptop.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# --- LLM provider (optional) --------------------------------------------
# Everything defaults to "local" - the model in the bundled `ollama`
# container. No key, no account, no internet after the first run.
#
# Set these to route the customer-facing reply (the slowest step) to
# Google Gemini instead: much faster, but needs a key and connectivity.
# Valid values per role: local | gemini
#
# The hybrid below is the recommended one - the frequent routing/reasoning
# steps stay free and local, only the step the user waits on goes to the
# cloud. Measured end to end on one two-agent question:
#   all-local, bundled container   ~318s
#   all-local, native Ollama        ~32s
#   hybrid (generative -> Gemini)   ~17s
# GENERATIVE_PROVIDER=gemini
# GEMINI_API_KEY=
# ROUTER_PROVIDER=local
# AGENT_REASON_PROVIDER=local
# AGENT_INTERPRET_PROVIDER=local
# EMBEDDING_PROVIDER=local
# One tag for every Gemini-routed role, as SHOPASSIST_MODEL is for the
# local ones. Flash is the fast/cheap choice; -pro is slower but stronger.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Which LLM backend the platform uses ---------------------------------
# lms    - a model served by LM Studio on this machine (needs LMSTUDIO_MODEL)
# local  - an Ollama installed on this machine (fastest with a host GPU)
# docker - the bundled Ollama container (no extra install; slowest)
#
# ./scripts/up.sh reads this; --lms / --local / --docker override it for a
# single run without editing the file.
SHOPASSIST_LLM_MODE=docker

# --- LM Studio (optional) -----------------------------------------------
# Serve the chat roles from a model running in LM Studio instead of Ollama.
# Start its server first (LM Studio -> Developer -> Start Server), then use
# the id exactly as reported by `curl http://localhost:1234/v1/models`.
# Run with: ./scripts/up.sh --lmstudio
# LMSTUDIO_MODEL=google/gemma-4-e2b
# LMSTUDIO_PORT=1234
# Optional: also serve embeddings from LM Studio. Must return exactly 768
# dimensions (nomic-embed-text-v1.5 does); the script verifies this before
# starting. Setting this also means the bundled Ollama container is not
# started at all, since nothing would be using it. Leave unset to keep
# embeddings on Ollama.
# LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# --- Operational --------------------------------------------------------
# LOG_LEVEL=INFO             # DEBUG also logs full request/response bodies
# RATE_LIMIT_PER_MINUTE=30   # per API key, or per client IP if none

# --- Chat timeout -------------------------------------------------------
# Seconds. Drives BOTH the API's own wall-clock cap and the storefront's
# HTTP read timeout, so the UI can't give up while the API is still
# working. One local chat turn makes several sequential CPU-only LLM
# calls; 360 leaves headroom on a laptop.
# CHAT_TIMEOUT_SECONDS=600

# --- Dummy API-key auth (optional) --------------------------------------
# Off by default. If you enable it, the storefront must send the same key
# (shopassist-client/config.yaml's api.api_key) or every chat 401s.
# API_KEY=
# API_KEY_ENFORCE=false

# --- LLM tracing (optional) ---------------------------------------------
# Blank = disabled, and OTEL_SDK_DISABLED=true stops the Langfuse SDK
# from trying to ship traces to its cloud anyway (without it, every
# request logs a 401 and makes an outbound call the platform doesn't
# need). To turn tracing on, set all three.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# OTEL_SDK_DISABLED=false
